{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Update GitLab merge request",
  "type": "object",
  "required": [],
  "properties": {
    "id": {
      "type": "string",
      "description": "Provider canonical record id.",
      "readOnly": true
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Provider creation timestamp.",
      "readOnly": true
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Provider last update timestamp.",
      "readOnly": true
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Provider URL for the record.",
      "readOnly": true
    },
    "identifier": {
      "type": "string",
      "description": "Provider human-readable identifier or key.",
      "readOnly": true
    },
    "provider": {
      "type": "string",
      "description": "Relayfile provider name.",
      "readOnly": true
    },
    "objectType": {
      "type": "string",
      "description": "Relayfile object type.",
      "readOnly": true
    },
    "objectId": {
      "type": "string",
      "description": "Relayfile object id.",
      "readOnly": true
    },
    "workspaceId": {
      "type": "string",
      "description": "Relayfile workspace id.",
      "readOnly": true
    },
    "connectionId": {
      "type": "string",
      "description": "Relayfile connection id.",
      "readOnly": true
    },
    "_webhook": {
      "type": "object",
      "description": "Provider webhook metadata captured during sync.",
      "readOnly": true,
      "additionalProperties": true
    },
    "_connection": {
      "type": "object",
      "description": "Relayfile connection metadata captured during sync.",
      "readOnly": true,
      "additionalProperties": true
    },
    "source_branch": {
      "type": "string",
      "description": "Existing source branch name."
    },
    "target_branch": {
      "type": "string",
      "description": "Target branch name."
    },
    "title": {
      "type": "string",
      "description": "Merge request title."
    },
    "description": {
      "type": "string",
      "description": "Markdown merge request description."
    },
    "labels": {
      "type": "array",
      "description": "Label names. The adapter sends them to GitLab as a comma-separated labels value.",
      "items": {
        "type": "string",
        "description": "GitLab label name."
      }
    },
    "remove_source_branch": {
      "type": "boolean",
      "description": "Whether GitLab should remove the source branch after merge."
    },
    "draft": {
      "type": "boolean",
      "description": "Whether to create the merge request as a draft."
    },
    "state_event": {
      "enum": [
        "close",
        "reopen"
      ],
      "description": "Lifecycle event for the merge request."
    }
  },
  "additionalProperties": false,
  "description": "Full resource record schema. Fields marked readOnly are synced from the provider and cannot be written by agents."
}
