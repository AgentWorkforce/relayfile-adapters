{
  "name": "@relayfile/adapter-bitbucket",
  "version": "0.8.2",
  "description": "Bitbucket Cloud adapter for Relayfile",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./path-mapper": "./dist/path-mapper.js",
    "./inbound": "./dist/inbound.js",
    "./webhook-normalizer": "./dist/webhook-normalizer.js",
    "./digest": "./dist/digest.js"
  },
  "files": [
    "dist",
    "discovery",
    "bitbucket.mapping.yaml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@relayfile/adapter-core": "^0.8.2"
  },
  "peerDependencies": {
    "@relayfile/sdk": ">=0.6.0 <1"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.18"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentWorkforce/relayfile-adapters",
    "directory": "packages/bitbucket"
  }
}
