{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Linear issue",
  "type": "object",
  "required": [
    "title"
  ],
  "anyOf": [
    {
      "required": [
        "teamId"
      ]
    },
    {
      "required": [
        "team"
      ]
    }
  ],
  "properties": {
    "teamId": {
      "type": "string",
      "format": "uuid",
      "description": "Linear team UUID. List `/linear/teams/` to find available teams."
    },
    "team": {
      "type": "object",
      "description": "Mounted/synced Linear team reference. Supply `id` directly, or resolve `key`/`name` against `/linear/teams/_index.json` with the issue-create preflight helper.",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Linear team UUID."
        },
        "key": {
          "type": "string",
          "description": "Linear team key, resolved through issue-create preflight."
        },
        "name": {
          "type": "string",
          "description": "Linear team name, resolved through issue-create preflight."
        }
      },
      "additionalProperties": true
    },
    "title": {
      "type": "string",
      "description": "Issue title.",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Markdown issue body."
    },
    "priority": {
      "enum": [
        0,
        1,
        2,
        3,
        4
      ],
      "description": "0=No priority, 1=Urgent, 2=High, 3=Medium, 4=Low."
    },
    "assigneeId": {
      "type": "string",
      "format": "uuid",
      "description": "Linear assignee user UUID."
    },
    "stateId": {
      "type": "string",
      "format": "uuid",
      "description": "Linear workflow state UUID."
    },
    "projectId": {
      "type": "string",
      "format": "uuid",
      "description": "Linear project UUID."
    },
    "cycleId": {
      "type": "string",
      "format": "uuid",
      "description": "Linear cycle UUID."
    },
    "labelIds": {
      "type": "array",
      "description": "Linear label UUIDs.",
      "items": {
        "type": "string",
        "format": "uuid",
        "description": "Linear label UUID."
      }
    },
    "labels": {
      "type": "array",
      "description": "Mounted/synced label references. Explicit `labelIds` are authoritative when both fields are present.",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "description": "Linear label name, resolved through issue-create preflight."
          },
          {
            "type": "object",
            "description": "Mounted/synced Linear label reference. Supply `id` directly, or resolve `name` against `/linear/labels/_index.json` with the issue-create preflight helper.",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "description": "Linear label UUID."
              },
              "name": {
                "type": "string",
                "description": "Linear label name, resolved through issue-create preflight."
              }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "addedLabelIds": {
      "type": "array",
      "description": "Linear label UUIDs to add without replacing the full label set. Do not combine with `labelIds`.",
      "items": {
        "type": "string",
        "format": "uuid",
        "description": "Linear label UUID."
      }
    },
    "removedLabelIds": {
      "type": "array",
      "description": "Linear label UUIDs to remove without replacing the full label set. Do not combine with `labelIds`.",
      "items": {
        "type": "string",
        "format": "uuid",
        "description": "Linear label UUID."
      }
    },
    "dueDate": {
      "type": "string",
      "format": "date",
      "description": "Due date in YYYY-MM-DD form."
    },
    "estimate": {
      "type": "number",
      "description": "Linear estimate value."
    },
    "parentId": {
      "type": "string",
      "format": "uuid",
      "description": "Parent issue UUID."
    },
    "id": {
      "type": "string",
      "description": "Provider canonical record id.",
      "readOnly": true
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Provider creation timestamp.",
      "readOnly": true
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Provider last update timestamp.",
      "readOnly": true
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Provider URL for the record.",
      "readOnly": true
    },
    "identifier": {
      "type": "string",
      "description": "Provider human-readable identifier or key.",
      "readOnly": true
    },
    "provider": {
      "type": "string",
      "description": "Relayfile provider name.",
      "readOnly": true
    },
    "objectType": {
      "type": "string",
      "description": "Relayfile object type.",
      "readOnly": true
    },
    "objectId": {
      "type": "string",
      "description": "Relayfile object id.",
      "readOnly": true
    },
    "workspaceId": {
      "type": "string",
      "description": "Relayfile workspace id.",
      "readOnly": true
    },
    "connectionId": {
      "type": "string",
      "description": "Relayfile connection id.",
      "readOnly": true
    },
    "_webhook": {
      "type": "object",
      "description": "Provider webhook metadata captured during sync.",
      "readOnly": true,
      "additionalProperties": true
    },
    "_connection": {
      "type": "object",
      "description": "Relayfile connection metadata captured during sync.",
      "readOnly": true,
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "description": "Full resource record schema. Fields marked readOnly are synced from the provider and cannot be written by agents."
}
