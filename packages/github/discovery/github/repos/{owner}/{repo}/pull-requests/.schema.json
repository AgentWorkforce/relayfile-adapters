{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub pull request",
  "type": "object",
  "required": [
    "title",
    "head",
    "base"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Provider canonical record id.",
      "readOnly": true
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Provider creation timestamp.",
      "readOnly": true
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Provider last update timestamp.",
      "readOnly": true
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Provider URL for the record.",
      "readOnly": true
    },
    "identifier": {
      "type": "string",
      "description": "Provider human-readable identifier or key.",
      "readOnly": true
    },
    "provider": {
      "type": "string",
      "description": "Relayfile provider name.",
      "readOnly": true
    },
    "objectType": {
      "type": "string",
      "description": "Relayfile object type.",
      "readOnly": true
    },
    "objectId": {
      "type": "string",
      "description": "Relayfile object id.",
      "readOnly": true
    },
    "workspaceId": {
      "type": "string",
      "description": "Relayfile workspace id.",
      "readOnly": true
    },
    "connectionId": {
      "type": "string",
      "description": "Relayfile connection id.",
      "readOnly": true
    },
    "_webhook": {
      "type": "object",
      "description": "Provider webhook metadata captured during sync.",
      "readOnly": true,
      "additionalProperties": true
    },
    "_connection": {
      "type": "object",
      "description": "Relayfile connection metadata captured during sync.",
      "readOnly": true,
      "additionalProperties": true
    },
    "title": {
      "type": "string",
      "description": "Pull request title."
    },
    "head": {
      "type": "string",
      "description": "Head branch or `owner:branch`."
    },
    "base": {
      "type": "string",
      "description": "Base branch."
    },
    "body": {
      "type": "string",
      "description": "Pull request description."
    },
    "draft": {
      "type": "boolean",
      "description": "Whether to create the pull request as a draft."
    },
    "maintainerCanModify": {
      "type": "boolean",
      "description": "Whether maintainers may modify the head branch."
    },
    "author": {
      "enum": [
        "app",
        "user"
      ],
      "description": "Credential identity selected by the write orchestrator; it is not sent in the GitHub REST body."
    }
  },
  "additionalProperties": false,
  "description": "Full resource record schema. Fields marked readOnly are synced from the provider and cannot be written by agents."
}
